{
  "LABEL": {
    "name": "title needs formatting",
    "color": "EEEEEE"
  },
  "CHECKS": {
    "prefixes": ["feat:", "fix:", "docs:", "chore:", "refactor:", "test:"],
    "regexp": "^(feat|fix|docs|chore|refactor|test)(\\(.+\\))?: .+",
    "regexpFlags": "i",
    "ignoreLabels": ["skip-title-check"],
    "alwaysPassCI": false
  },
  "MESSAGES": {
    "success": "PR title follows contribution guidelines",
    "failure": "PR title does not follow contribution guidelines",
    "notice": ""
  }
}
